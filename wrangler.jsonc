{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnpolish",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  // Builds the front end before every deploy, so a plain `wrangler deploy` (the Workers Builds default) works.
  "build": { "command": "npm run build" },
  "routes": [{ "pattern": "polish.saluki.cloud", "custom_domain": true }],
  "observability": { "enabled": true },
  // Daily practice reminders run on a Durable Object's hourly alarm (src/worker/clock.ts), not a Cron Trigger:
  // the account's Cron Triggers are all in use. SQLite-backed Durable Objects and alarms are on the free plan.
  // It starts itself on the first API request after a deploy. No crons here, so a deploy never fails on the limit.
  "durable_objects": { "bindings": [{ "name": "REMINDER_CLOCK", "class_name": "ReminderClock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReminderClock"] }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learnpolish-db",
      "database_id": "50af2708-c87e-4aee-a9e2-3d74b321737c",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI: transcribes spoken answers (Whisper) for browsers without their own speech recognition
  // (src/worker/routes/speech.ts). Runs within the free plan's daily allowance; beyond it, speaking
  // practice falls back to listening back and marking yourself.
  "ai": { "binding": "AI" },
  // Worker Previews (pull request builds) need this block and do not inherit anything else here.
  // It is left empty on purpose: Previews get no database, so they can never touch production data,
  // and the app runs in guest mode there (the API reports accounts as unavailable).
  "previews": {},
  "vars": {
    // PBKDF2 work factor. 30,000 keeps sign-in inside the free plan's ~10 ms CPU budget.
    // On the paid plan raise it to 100,000 (the Workers maximum); hashes upgrade on next sign-in.
    "PBKDF2_ITERATIONS": "30000",
    // Sent to push services with each reminder so they can contact the operator (VAPID "sub").
    "PUSH_CONTACT": "https://polish.saluki.cloud",
    // Whisper transcriptions a day for everyone together, kept under the free Workers AI allowance so a flood
    // of requests can't use it all up. Guests may use at most half; learners with an account keep the rest.
    "SPEECH_DAILY_LIMIT": "2000"
  }
  // Optional secret (not committed): PEPPER, 32+ characters. See README → Deploying.
  // The Worker applies pending migrations itself on first request (src/worker/migrate.ts).
}
